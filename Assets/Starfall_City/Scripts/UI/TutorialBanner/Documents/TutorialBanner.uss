:root {
}

.tutorial-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.backdrop {
    background-color: rgba(0, 0, 0, 0.85);
    position: absolute;
    width: 100%;
    height: 100%;
}

.tutorial-card {
    background-color: rgb(26, 0, 51);
    border-radius: 20px;
    border-width: 4px;
    border-color: rgb(255, 0, 255);
    padding: 30px;
    width: 90%;
    max-width: 800px;
    box-shadow: 0 0 30px rgba(255, 0, 255, 0.6);
    flex-direction: column;
    align-items: center;
}

.tutorial-content {
    width: 100%;
    flex-direction: column;
    gap: 18px;
    margin-bottom: 25px;
}

.tutorial-title {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgb(255, 0, 255);
    text-shadow: 0 0 15px rgb(255, 0, 255);
    margin-bottom: 10px;
}

.tutorial-subtitle {
    font-size: 28px;
    color: rgb(255, 255, 255);
    margin-bottom: 30px;
}

.tutorial-row {
    flex-direction: row;
    align-items: center;
}

.icon-arrow {
    width: 60px;
    height: 60px;
    background-color: rgb(63, 26, 63);
    border-radius: 50%;
    background-size: 70%;
    background-repeat: no-repeat;
    background-position: center;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
}

.icon-container {
    flex-direction: row;
}

.tutorial-text {
    font-size: 26px;
    color: rgb(255, 255, 255);
    flex-grow: 1;
}

.tutorial-close-button {
    background-color: rgb(255, 0, 255);
    border-radius: 50px;
    padding: 18px 40px;
    margin-top: 20px;
    font-size: 32px;
    -unity-font-style: bold;
    color: black;
    transition-duration: 0.15s;
}

.tutorial-close-button:hover {
    background-color: rgb(255, 102, 255);
}

.tutorial-close-button:active {
    background-color: rgb(204, 0, 204);
}

.tutorial-protip {
    font-size: 24px;
    color: rgb(255, 255, 102);
    -unity-font-style: italic;
    margin: 20px 0;
    -unity-text-align: center;
}
