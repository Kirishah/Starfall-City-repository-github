:root {
}

.dialogue-panel {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 156, 0);
    border-right-color: rgb(255, 156, 0);
    border-top-color: rgb(255, 156, 0);
    border-bottom-color: rgb(255, 156, 0);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    background-color: rgb(114, 47, 55);
    display: none;
}

.speaker-name {
    color: rgb(248, 240, 227);
    -unity-font-style: bold;
    font-size: 24px;
}

.narrative-desc {
    color: rgb(230, 211, 163);
    font-size: 16px;
    margin-bottom: 10px;
}

.history-content {
    padding: 8px;
}

.history-entry {
    margin-bottom: 12px;
    padding: 4px 8px;
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 3px;
    border-left-color: rgb(255, 156, 0);
    color: #E6D3A3;
    font-size: 18px;
}

.history-entry:hover {
    background-color: rgba(0, 255, 255, 0.1);
}

.history-narrative {
    color: rgb(248, 240, 227);
    border-left-color: rgb(255, 0, 255);
    font-size: 18px;
}

.history-player {
    -unity-font-style: bold;
    color: rgb(0, 255, 255);
    text-align: right;
    font-size: 18px;
}

.choice-container {
    padding: 8px;
}

.choice-button {
    background-color: rgb(106, 58, 74);
    border: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    color: rgb(248, 240, 227);
    -unity-font-style: bold;
    padding: 8px 16px;
    margin: 4px;
    cursor: pointer;
}

.choice-button:hover {
    background-color: rgb(74, 12, 42);
    scale: 1.05 1.05;
}

.choice-button:active {
    background-color: rgb(90, 47, 61);
    scale: 0.98 0.98;
}
