<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Starfall_City/Scripts/UI/Dialogue/Documents/Dialogue.uss?fileID=7433441132597879392&amp;guid=d37309d1816ea344b8a74a739c218e10&amp;type=3#Dialogue" />
    <ui:VisualElement name="Root" style="flex-grow: 1; align-items: center; justify-content: flex-end;">
        <ui:VisualElement name="DialoguePanel" class="dialogue-panel" style="height: 40%; width: 50%; flex-direction: column; border-left-color: rgb(201, 169, 106); border-right-color: rgb(201, 169, 106); border-top-color: rgb(201, 169, 106); border-bottom-color: rgb(201, 169, 106); display: none;">
            <ui:VisualElement name="NarrativeContainer" style="flex-grow: 1; width: 100%; height: 70%; flex-direction: row; justify-content: flex-start;">
                <ui:VisualElement name="IconContainer" style="width: 25%; height: 100%; align-items: center; justify-content: center;">
                    <ui:Image name="Icon" style="width: 200px; height: 200px; border-radius: 50%; background-color: rgba(255, 255, 255, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(201, 169, 106); border-right-color: rgb(201, 169, 106); border-top-color: rgb(201, 169, 106); border-bottom-color: rgb(201, 169, 106); flex-grow: 0;" />
                    <ui:Label text="Speaker" name="CharName" class="speaker-name" />
                </ui:VisualElement>
                <ui:ScrollView name="HistoryScrollView" class="history-scroll" style="width: 75%; height: 100%; padding-left: 10px; background-color: rgba(0, 0, 0, 0.3); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(201, 169, 106); border-right-color: rgb(201, 169, 106); border-top-color: rgb(201, 169, 106); border-bottom-color: rgb(201, 169, 106); margin-left: 40px;">
                    <ui:VisualElement name="HistoryContent" class="history-content" style="flex-direction: column;" />
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="ChoiceContainer" class="choice-container" style="flex-grow: 1; width: 100%; height: 30%; justify-content: center; align-items: center;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
