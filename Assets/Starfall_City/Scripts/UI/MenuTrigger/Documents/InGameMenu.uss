:root {
}

.button {
    width: 80%;
    margin-top: 1%;
    margin-right: 1%;
    margin-bottom: 1%;
    margin-left: 1%;
    height: 8%;
    color: rgba(27, 27, 27, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.menuBar {
    align-self: center;
    top: 30%;
    width: 40%;
    height: 60%;
    justify-content: flex-start;
    align-items: center;
    align-content: auto;
}

.exit-button {
    width: 50%;
    color: rgba(27, 27, 27, 0);
    height: 95%;
    align-self: center;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.exitContainer {
    top: auto;
    flex-direction: row;
    width: 100%;
    margin-top: 0%;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 15px;
    padding-right: 15px;
    padding-bottom: 15px;
    padding-left: 15px;
    justify-content: center;
    height: 15%;
}
